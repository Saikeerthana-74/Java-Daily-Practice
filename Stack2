//Stack using the Linked List
class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

public class Stack2 {

    Node head = null;

    void push(int data) {//For adding the data into the stack
        Node newNode = new Node(data);

        newNode.next = head;
        head = newNode;

        System.out.println(data + " pushed");
    }

    void pop() {//Removing the data from the stack
        if (head == null) {
            System.out.println("Stack Underflow");
            return;
        }

        System.out.println(head.data + " popped");
        head = head.next;
    }

    void peek() {//Displaying the peek element from the stack
        if (head == null) {
            System.out.println("Stack is Empty");
            return;
        }

        System.out.println("Top Element: " + head.data);
    }

    void display() {//For displaying the value
        if (head == null) {
            System.out.println("Stack is Empty");
            return;
        }

        Node temp = head;

        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }

        System.out.println();
    }

    public static void main(String[] args) {

        Stack2 s = new Stack2();

        s.push(10);
        s.push(20);
        s.push(30);

        s.display();

        s.pop();

        s.peek();

        s.display();
    }
}
