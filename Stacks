//using array creating stack
import java.util.*;
class Stack{
    int [] stack;
    int top;
    int size;
    Stack(int size){
        this.size=size;
        stack = new int[size];
        top=-1;
    }
    void push(int value){//For adding the data into the stack 
        if(isFull()){
            System.out.println("Stack is Overflow");
        }
        else{
            stack[++top]=value;
            System.out.println("Value is pushed"+value);
        }
    }
    void pop(int value){//for removing the elemnet from the stack
        if(isEmpty()){
            System.out.println("Stack is Empty");
        }
        else{
            stack[--top]=value;
            System.out.println("Value is deleted"+value);
        }
    }
    void peek(){//to print the top most value 
        if(top==-1){
            System.out.println("The stack is empty");
        }
        else{
            System.out.println("The peek Element is:"+stack[top]);
        }
    }
    void display() {//To display the stack elements 
        if (isEmpty()) {
            System.out.println("Stack is Empty");
        } else {
            for (int i = top; i >= 0; i--) {
                System.out.print(stack[i] + " ");
            }
            System.out.println();
        }
    }
    public boolean isEmpty(){//to check wheather the stack is empty or not
        if(top==-1){
            return true;
        }
        return false;
    }
    public boolean isFull(){//to check whether the stack is full or not
        if(top==size-1){
            return true;
        }
        return false;
    }
}
